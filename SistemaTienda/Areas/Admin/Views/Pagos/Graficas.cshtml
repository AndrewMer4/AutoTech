@using System.Text.Json
@model SistemaTienda.Models.ViewModels.GraficasVM

@{
    ViewData["Title"] = "Estadísticas de Rentas";
}

<style>
    :root {
        --primary-color: #343a40;
        --secondary-color: #6c757d;
        --success-color: #198754;
        --chart-color-1: #4e73df;
        --chart-color-2: #1cc88a;
        --chart-color-3: #36b9cc;
    }

    .stats-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .section-title {
        color: var(--primary-color);
        font-weight: 700;
        font-size: 2.2rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .card-custom:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
        }

    .card-header-custom {
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        font-size: 1.2rem;
        border-radius: 12px 12px 0 0 !important;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .btn-back {
        background-color: var(--secondary-color);
        color: white;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        margin-bottom: 1.5rem;
    }

        .btn-back:hover {
            background-color: #5a6268;
            color: white;
            transform: translateX(-3px);
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--success-color);
        margin: 0.5rem 0;
    }

    .stat-label {
        font-size: 1rem;
        color: var(--secondary-color);
        margin-bottom: 0;
    }

    .chart-container {
        height: 350px;
        position: relative;
        margin: 1rem 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .no-data-message {
        color: var(--secondary-color);
        font-style: italic;
        text-align: center;
        padding: 1rem;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .section-title {
            font-size: 1.8rem;
        }

        .stat-number {
            font-size: 2rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .header-section {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="stats-container">
    <!-- Encabezado con botón de regreso -->
    <div class="header-section">
        <h1 class="section-title">
            <i class="fas fa-chart-line"></i> Estadísticas de Rentas
        </h1>
        <a asp-action="Index" asp-controller="Pagos" asp-area="Admin" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> Volver a Pagos
        </a>
    </div>

    <!-- Grid de estadísticas -->
    <div class="stats-grid">
        <!-- Ganancias Totales -->
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fas fa-dollar-sign"></i> Ganancias Totales
            </div>
            <div class="card-body-custom text-center">
                <div class="stat-number">@Model.GananciasTotales.ToString("C")</div>
                <p class="stat-label">Total acumulado de pagos completados</p>
            </div>
        </div>

        <!-- Vehículo más rentado -->
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fas fa-car-side"></i> Vehículo Más Rentado
            </div>
            <div class="card-body-custom text-center">
                @if (Model.CantidadRentasVehiculo > 0)
                {
                    <h5 class="fw-bold mb-2">@Model.VehiculoMasRentado</h5>
                    <div class="stat-number">@Model.CantidadRentasVehiculo</div>
                    <p class="stat-label">veces rentado</p>
                }
                else
                {
                    <p class="no-data-message">No hay datos de rentas disponibles</p>
                }
            </div>
        </div>
    </div>

    <!-- Gráfica de distribución -->
    <div class="card card-custom">
        <div class="card-header card-header-custom">
            <i class="fas fa-chart-pie"></i> Distribución de Rentas por Vehículo
        </div>
        <div class="card-body-custom">
            <div class="chart-container">
                <canvas id="graficaPastel"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var distribucion = @Html.Raw(Json.Serialize(Model.DistribucionVehiculos));

            if (distribucion && distribucion.length > 0) {
                var labels = distribucion.map(x => x.vehiculoInfo);
                var data = distribucion.map(x => x.cantidadRentas);
                var percentages = distribucion.map(x => x.porcentaje);

                var backgroundColors = [
                    '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                    '#858796', '#fd7e14', '#20c997', '#6f42c1', '#0dcaf0'
                ].slice(0, data.length);

                var ctx = document.getElementById('graficaPastel').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: backgroundColors,
                            borderColor: '#fff',
                            borderWidth: 2,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 12,
                                    padding: 20,
                                    font: {
                                        size: 13
                                    },
                                    usePointStyle: true
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var label = context.label || '';
                                        var value = context.raw || 0;
                                        var percentage = percentages[context.dataIndex];
                                        return `${label}: ${value} (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '60%',
                        animation: {
                            animateScale: true,
                            animateRotate: true
                        }
                    }
                });
            } else {
                document.getElementById('graficaPastel').closest('.card').innerHTML = `
                    <div class="card-body-custom">
                        <p class="no-data-message">No hay datos disponibles para mostrar la gráfica</p>
                    </div>
                `;
            }
        });
    </script>
}