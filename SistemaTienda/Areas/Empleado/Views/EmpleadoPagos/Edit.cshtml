@model SistemaTienda.Models.ViewModels.PagoVM

@{
    ViewData["Title"] = "Editar Pago";
}
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    .font-title {
        font-family: 'Bebas Neue', sans-serif;
        letter-spacing: 1px;
    }

    .form-container {
        background-color: #f9f9f9;
        border-radius: 1rem;
        padding: 2rem;
        max-width: 800px;
        margin: auto;
        box-shadow: 0 0 15px rgba(0,0,0,0.07);
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control {
        border-radius: 0.5rem;
    }

    .btn-dark {
        font-weight: 500;
        padding: 10px 25px;
    }
</style>

<div class="container mt-5">
    <h1 class="text-center display-4 text-black font-title mb-4">Editar Pago</h1>

    <form asp-area="Empleado"
          asp-controller="EmpleadoPagos"
          asp-action="Edit"
          method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Pago.Id" />

        <div class="form-container">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Select2 Renta con valor inicial -->
            <div class="mb-3">
                <label asp-for="Pago.RentaId" class="form-label">Renta</label>
                <select asp-for="Pago.RentaId"
                        class="form-control js-select2-renta"
                        data-url="@Url.Action("GetRentas","EmpleadoPagos", new { area="Empleado" })"
                        data-init-id="@Model.Pago.RentaId"
                        data-init-text="@Model.ListaRentas.FirstOrDefault(x => x.Value == Model.Pago.RentaId.ToString())?.Text">
                    <option></option>
                </select>
                <span asp-validation-for="Pago.RentaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pago.Monto" class="form-label">Monto</label>
                <input asp-for="Pago.Monto" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Pago.Estado" class="form-label">Estado</label>
                <select asp-for="Pago.Estado" class="form-control">
                    <option value="Pendiente" selected="@(Model.Pago.Estado == "Pendiente")">Pendiente</option>
                    <option value="Completado" selected="@(Model.Pago.Estado == "Completado")">Completado</option>
                </select>
            </div>

            <div class="mb-4">
                <label asp-for="Pago.Notas" class="form-label">Notas</label>
                <textarea asp-for="Pago.Notas" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-area="Empleado" asp-controller="EmpleadoPagos" asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
                <button type="submit" class="btn btn-dark">
                    <i class="fas fa-save me-2"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(function() {
            var $renta = $('.js-select2-renta');
            $renta.select2({
                placeholder: 'Escriba para buscar renta…',
                allowClear: true,
                ajax: {
                    url: $renta.data('url'),
                    dataType: 'json',
                    delay: 250,
                    data: params => ({ term: params.term }),
                    processResults: resp => ({ results: resp.results })
                },
                minimumInputLength: 1,
                width: '100%'
            });

            // Preseleccionar la opción editada
            var initId = $renta.data('init-id'),
                initText = $renta.data('init-text');
            if (initId && initText) {
                var option = new Option(initText, initId, true, true);
                $renta.append(option).trigger('change');
            }

            $renta.on('select2:select', function(e) {
                const rentaId = e.params.data.id;
                $.getJSON('@Url.Action("GetMonto", "EmpleadoPagos", new { area = "Empleado" })',
                    { rentaId }, d => {
                        $("input[name='Pago.Monto']").val(d.monto.toFixed(2));
                    });
            });
        });
    </script>
}
